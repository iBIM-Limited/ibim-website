{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ibim-website",
  "account_id": "4a0e0622ac1b16fb26d756daf8e9b1f3",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true },
  // Hourly: re-send any enquiry whose notification email failed (see resendMissed in worker/index.js).
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "ibim-enquiries", "database_id": "f216721c-9b8d-4505-99e6-91789a9701a2", "migrations_dir": "migrations" }
  ],
  // Worker routes serve the site on the proxied records, so no DNS records change.
  "routes": [
    { "pattern": "www.i-bim.co.uk/*", "zone_name": "i-bim.co.uk" },
    { "pattern": "i-bim.co.uk/*", "zone_name": "i-bim.co.uk" }
  ],
  "env": {
    "local": {
      "name": "ibim-website-local",
      "d1_databases": [
        { "binding": "DB", "database_name": "ibim-enquiries-local", "database_id": "local", "migrations_dir": "migrations" }
      ]
    },
    "preview": {
      "name": "ibim-website-preview",
      "routes": [],
      "workers_dev": true,
      "triggers": { "crons": [] },
      "d1_databases": [
        { "binding": "DB", "database_name": "ibim-enquiries-preview", "database_id": "23d3859c-2c9e-474f-962a-f1098e8ba30a", "migrations_dir": "migrations" }
      ]
    }
  }
}
