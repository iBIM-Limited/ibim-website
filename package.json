{
  "name": "ibim-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:3d && astro build",
    "build:3d": "esbuild src/3d/visual3d.js --bundle --minify --format=esm --target=es2020 --outfile=public/js/visual3d.js && esbuild src/3d/scene-viewer.js --bundle --minify --format=esm --target=es2022 --outfile=public/js/scene-viewer.js",
    "preview": "npm run build && wrangler dev --env local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sparkjsdev/spark": "^2.4.0",
    "astro": "^7.4.7",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide-static": "^1.75.0",
    "wrangler": "^4.158.0"
  }
}
