---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', strokeWidth = 1.75 } = Astro.props;

let svgContent = '';
try {
  const iconPath = path.resolve(`node_modules/lucide-static/icons/${name}.svg`);
  const raw = fs.readFileSync(iconPath, 'utf-8');
  svgContent = raw
    .replace(/<!--[\s\S]*?-->\s*/, '')
    .replace(/<svg([^>]*)>/, (_m, attrs) =>
      `<svg${attrs.replace(/\s(class|width|height|stroke-width)="[^"]*"/g, '')} class="icon icon--${name} ${className}" width="${size}" height="${size}" stroke-width="${strokeWidth}" aria-hidden="true" focusable="false">`);
} catch (e) {
  console.warn(`Icon "${name}" not found`);
}
---
<Fragment set:html={svgContent} />
