---
interface Props { kind: 'contact' | 'waitlist' }
const { kind } = Astro.props;
const success = kind === 'waitlist' ? 'You’re on the waiting list. We’ll email you when there’s news.' : 'Message sent. We’ll reply as soon as we can.';
---
<form class="form" method="post" action="/api/enquiry" data-enquiry data-success={success} novalidate>
  <input type="hidden" name="kind" value={kind} />
  <div class="trap" aria-hidden="true">
    <label for={`${kind}-website`}>Leave this empty</label>
    <input id={`${kind}-website`} name="website" tabindex="-1" autocomplete="off" />
  </div>
  {kind === 'contact' ? (
    <>
      <div class="field"><label for="contact-first">First name</label><input id="contact-first" name="first_name" autocomplete="given-name" /></div>
      <div class="field"><label for="contact-email">Email address <span class="req">(required)</span></label><input id="contact-email" name="email" type="email" required autocomplete="email" /></div>
      <div class="field field--wide"><label for="contact-message">What can we help with? <span class="req">(required)</span></label><textarea id="contact-message" name="message" rows="6" required></textarea></div>
    </>
  ) : (
    <>
      <div class="field"><label for="wl-first">First name <span class="req">(required)</span></label><input id="wl-first" name="first_name" required autocomplete="given-name" /></div>
      <div class="field"><label for="wl-last">Last name <span class="req">(required)</span></label><input id="wl-last" name="last_name" required autocomplete="family-name" /></div>
      <div class="field"><label for="wl-company">Company <span class="req">(required)</span></label><input id="wl-company" name="company" required autocomplete="organization" /></div>
      <div class="field"><label for="wl-title">Job title <span class="req">(required)</span></label><input id="wl-title" name="job_title" required autocomplete="organization-title" /></div>
      <div class="field field--wide"><label for="wl-email">Work email <span class="req">(required)</span></label><input id="wl-email" name="email" type="email" required autocomplete="email" /></div>
    </>
  )}
  <div class="form__foot field--wide">
    <button class="button" type="submit">{kind === 'waitlist' ? 'Join the waiting list' : 'Send message'}</button>
    <p class="small">We use these details only to respond to you. See our <a href="/privacy">privacy notice</a>.</p>
  </div>
  <p class="form__status field--wide" role="status" data-status hidden></p>
</form>
