---
interface Props {
  kind: 'contact' | 'waitlist';
}

const { kind } = Astro.props;
const page = Astro.url.pathname.replace(/\.html$/, '') || '/';
const success = kind === 'waitlist'
  ? 'You’re on the waiting list. We’ll email you when there’s news.'
  : 'Message sent. Jack Ward will reply within one working day, by email or phone.';

const needOptions = ['Drawings', 'Scan / model', 'BIM support', 'Software', 'Not sure'];
---
<form
  class="form"
  method="post"
  action="/api/enquiry"
  data-enquiry
  data-kind={kind}
  data-success={success}
  novalidate
>
  <input type="hidden" name="kind" value={kind} />
  <input type="hidden" name="source_page" value={page} />
  <input type="hidden" name="referrer" value="" />
  {kind === 'contact' && <input type="hidden" name="service" value="" />}

  <!-- Honeypot -->
  <div class="trap" aria-hidden="true">
    <label for={`${kind}-website`}>Leave this empty</label>
    <input id={`${kind}-website`} name="website" tabindex="-1" autocomplete="off" />
  </div>

  {kind === 'contact' ? (
    <>
      <p class="form__about" data-about hidden></p>
      <fieldset class="field" style="border: 0; padding: 0; margin: 0;">
        <legend style="margin-bottom: 8px; font-weight: 600; font-size: 14.5px;">What do you need?</legend>
        <div class="radio-group" role="radiogroup" aria-label="What do you need?">
          {needOptions.map((opt) => (
            <label class="radio-chip">
              <input type="radio" name="need" value={opt} />
              <span class="radio-chip__label">{opt}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field">
        <label for="contact-project">The building or project</label>
        <textarea
          id="contact-project"
          name="project"
          rows="4"
          placeholder="Two-storey extension, existing 1960s school block, or tell us what you need"
        ></textarea>
      </div>

      <div class="field">
        <label for="contact-reply">
          Email or phone <span class="req">(required)</span>
        </label>
        <input
          id="contact-reply"
          aria-describedby="contact-reply-help"
          name="reply"
          type="text"
          required
          autocomplete="email"
          autocapitalize="none"
          spellcheck="false"
          placeholder="07123 456789 or name@example.co.uk"
        />
        <span class="field-help" id="contact-reply-help">Enter a full UK number or an email so we can reply.</span>
      </div>

      <div class="field">
        <label for="contact-when">When do you need it?</label>
        <input
          id="contact-when"
          name="when"
          type="text"
          placeholder="Planning submission in six weeks, or dates"
        />
      </div>

      <div class="field">
        <label for="contact-heard">
          How did you hear about us? <span class="req">(optional)</span>
        </label>
        <input id="contact-heard" name="heard" type="text" />
      </div>

      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: 8px;">
        <span class="form__person-note">Jack replies personally.</span>
        <button class="button button--action button--large" type="submit">
          Send enquiry
        </button>
      </div>
      <p class="small">We use these details only to respond to you. See our <a href="/privacy">privacy notice</a>.</p>
    </>
  ) : (
    <>
      <div class="field">
        <label for="wl-first">First name <span class="req">(required)</span></label>
        <input id="wl-first" type="text" name="first_name" required autocomplete="given-name" />
      </div>
      <div class="field">
        <label for="wl-last">Last name <span class="req">(required)</span></label>
        <input id="wl-last" type="text" name="last_name" required autocomplete="family-name" />
      </div>
      <div class="field">
        <label for="wl-company">Company <span class="req">(required)</span></label>
        <input id="wl-company" type="text" name="company" required autocomplete="organization" />
      </div>
      <div class="field">
        <label for="wl-title">Job title <span class="req">(required)</span></label>
        <input id="wl-title" type="text" name="job_title" required autocomplete="organization-title" />
      </div>
      <div class="field">
        <label for="wl-email">Work email <span class="req">(required)</span></label>
        <input id="wl-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="wl-heard">How did you hear about us? <span class="req">(optional)</span></label>
        <input id="wl-heard" name="heard" type="text" />
      </div>
      <div style="margin-top: 8px;">
        <button class="button button--action button--large" type="submit">
          Join the waiting list
        </button>
      </div>
      <p class="small">We use these details only to contact you about the digital twin platform. See our <a href="/privacy">privacy notice</a>.</p>
    </>
  )}

  <div class="form-status" role="status" data-status hidden></div>
</form>
