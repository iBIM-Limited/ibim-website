---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import { allServices, architecturalServices, services, contact, promise } from '../data/services';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const canonical = new URL(path, Astro.site).toString().replace(/\/$/, path === '/' ? '/' : '');
const fullTitle = path === '/' ? title : `${title} | iBIM`;
const year = new Date().getFullYear();

const archActive = architecturalServices.some((s) => `/${s.slug}` === path);
const bimActive = services.some((s) => `/${s.slug}` === path);

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'iBIM',
  legalName: 'iBIM Limited',
  founder: { '@type': 'Person', name: 'Jack Ward', jobTitle: 'Director' },
  url: 'https://www.i-bim.co.uk/',
  logo: 'https://www.i-bim.co.uk/img/ibim-logo.png',
  description: 'iBIM is the UK’s digital delivery practice for the built environment: architectural services, BIM and information management, and software and automation, from one team that understands all three.',
  telephone: contact.phone,
  email: contact.email,
  areaServed: [
    { '@type': 'City', name: 'Preston' },
    { '@type': 'AdministrativeArea', name: 'Lancashire' },
    { '@type': 'Country', name: 'United Kingdom' },
  ],
  sameAs: [contact.linkedin],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/img/ibim-monogram-primary.png" />
    <link rel="apple-touch-icon" href="/img/ibim-monogram-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="iBIM" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.i-bim.co.uk/img/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? organisation)} />
    <script is:inline src="/js/site.js?v=3" defer></script>
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "64da2e5d8f0e422d96f5719483f89ca1"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="site-header__brand" aria-label="iBIM home">
          <img src="/img/ibim-wordmark-bar-primary.png" alt="iBIM" width="75" height="34" />
        </a>

        <!-- Desktop Navigation (5.5) -->
        <nav class="nav-desktop" aria-label="Main navigation">
          <details class="nav-dropdown" data-dropdown>
            <summary aria-current={archActive ? 'true' : undefined}>
              Architectural
              <Icon name="chevron-down" size={16} />
            </summary>
            <div class="dropdown-menu">
              {architecturalServices.map((s) => (
                <a href={`/${s.slug}`} aria-current={`/${s.slug}` === path ? 'page' : undefined}>
                  {s.name}
                </a>
              ))}
            </div>
          </details>

          <details class="nav-dropdown" data-dropdown>
            <summary aria-current={bimActive ? 'true' : undefined}>
              BIM and digital
              <Icon name="chevron-down" size={16} />
            </summary>
            <div class="dropdown-menu">
              {services.map((s) => (
                <a href={`/${s.slug}`} aria-current={`/${s.slug}` === path ? 'page' : undefined}>
                  {s.name}
                </a>
              ))}
            </div>
          </details>

          <a href="/software-development" class="nav-link" aria-current={path === '/software-development' ? 'page' : undefined}>
            Software and automation
          </a>

          <a href="/about" class="nav-link" aria-current={path === '/about' ? 'page' : undefined}>
            About
          </a>

          <a class="button button--small button--primary" href="/contact">
            Start a project
          </a>
        </nav>

        <!-- Mobile Menu Trigger -->
        <button type="button" class="menu-toggle" data-mobile-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-sheet">
          <Icon name="menu" size={24} />
        </button>
      </div>
    </header>

    <!-- Mobile Full-Screen Ink Sheet (5.5) -->
    <div id="mobile-sheet" class="mobile-sheet" data-mobile-sheet aria-hidden="true" inert>
      <div class="mobile-sheet__head">
        <span class="eyebrow eyebrow--on-ink">Menu</span>
        <button type="button" class="mobile-sheet__close" data-mobile-close aria-label="Close menu">
          <Icon name="x" size={24} />
        </button>
      </div>

      <nav class="mobile-sheet__nav" aria-label="Mobile menu">
        <a href="/" class="mobile-sheet__link" aria-current={path === '/' ? 'page' : undefined}>Home</a>

        <details class="mobile-sheet__group">
          <summary class="mobile-sheet__link">Architectural</summary>
          <div class="mobile-sheet__sublinks">
            {architecturalServices.map((s) => (
              <a href={`/${s.slug}`} class="mobile-sheet__sublink" aria-current={`/${s.slug}` === path ? 'page' : undefined}>
                {s.name}
              </a>
            ))}
          </div>
        </details>

        <details class="mobile-sheet__group">
          <summary class="mobile-sheet__link">BIM and digital</summary>
          <div class="mobile-sheet__sublinks">
            {services.map((s) => (
              <a href={`/${s.slug}`} class="mobile-sheet__sublink" aria-current={`/${s.slug}` === path ? 'page' : undefined}>
                {s.name}
              </a>
            ))}
          </div>
        </details>

        <a href="/software-development" class="mobile-sheet__link" aria-current={path === '/software-development' ? 'page' : undefined}>
          Software and automation
        </a>

        <a href="/about" class="mobile-sheet__link" aria-current={path === '/about' ? 'page' : undefined}>
          About
        </a>

        <a href="/contact" class="mobile-sheet__link" aria-current={path === '/contact' ? 'page' : undefined}>
          Contact
        </a>
      </nav>

      <div class="mobile-sheet__foot">
        <a href={contact.phoneHref} class="mobile-sheet__phone">
          {contact.person}: {contact.phone}
        </a>
        <a class="button button--large button--action" href="/contact">
          Start a project
        </a>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <!-- Footer (Brand Rules 2.4, 2.6, 2.9, 5.5) -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <!-- Col 1: Logo & Promise -->
          <div class="footer-brand">
            <a href="/" aria-label="iBIM home">
              <img src="/img/ibim-logo.png" alt="iBIM: simplifying AEC with integrated digital solutions" width="180" height="134" />
            </a>
            <p class="footer-promise">{promise}</p>
          </div>

          <!-- Col 2: Architectural Services -->
          <div class="footer-col">
            <h2 class="footer-col__heading">Architectural</h2>
            <ul>
              {architecturalServices.map((s) => (
                <li><a href={`/${s.slug}`}>{s.name}</a></li>
              ))}
            </ul>
          </div>

          <!-- Col 3: BIM & Digital -->
          <div class="footer-col">
            <h2 class="footer-col__heading">BIM and digital</h2>
            <ul>
              {services.map((s) => (
                <li><a href={`/${s.slug}`}>{s.name}</a></li>
              ))}
              <li><a href="/software-development">Software and automation</a></li>
            </ul>
          </div>

          <!-- Col 4: Contact & Location -->
          <div class="footer-col">
            <h2 class="footer-col__heading">Contact</h2>
            <div class="footer-contact">
              <strong>{contact.person}</strong>
              <span>{contact.role}</span>
              <a href={contact.phoneHref}>{contact.phone}</a>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
              <span class="small">Hours: {contact.hours}</span>
              <a href={contact.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
              <a href="/preston-lancashire" class="small" style="margin-top: 6px;">Areas we cover: Preston and Lancashire</a>
            </div>
          </div>
        </div>

        <!-- Baseline Bar Graphic Device (3.6) -->
        <div class="baseline-bar footer-baseline" aria-hidden="true"></div>

        <div class="footer-bottom">
          <div class="footer-links">
            <span>© {year} iBIM Limited.</span>
            <a href="/privacy">Privacy</a>
            <a href="/contact">Contact</a>
          </div>
          <p class="footer-legal">
            iBIM Limited. Registered in England and Wales, company number {contact.companyNumber}. Registered office: {contact.registeredOffice}.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
