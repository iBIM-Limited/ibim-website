---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource/space-mono/400.css';
import '../styles/site.css';
import { allServices, architecturalServices, services, contact } from '../data/services';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object;
}
const { title, description, noindex = false, jsonLd } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const canonical = new URL(path, Astro.site).toString().replace(/\/$/, path === '/' ? '/' : '');
const fullTitle = path === '/' ? title : `${title} | iBIM`;
const year = new Date().getFullYear();
const servicesActive = allServices.some((s) => `/${s.slug}` === path);
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'iBIM',
  legalName: 'iBIM Limited',
  url: 'https://www.i-bim.co.uk/',
  logo: 'https://www.i-bim.co.uk/img/ibim-logo.png',
  description: 'BIM consultancy offering end-to-end BIM lifecycle consulting for architecture, engineering, construction and operations.',
  telephone: contact.phone,
  email: contact.email,
  areaServed: [{ '@type': 'City', name: 'Preston' }, { '@type': 'AdministrativeArea', name: 'Lancashire' }, { '@type': 'Country', name: 'United Kingdom' }],
  sameAs: [contact.linkedin],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/img/ibim-mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="iBIM" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.i-bim.co.uk/img/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? organisation)} />
    <script is:inline src="/js/site.js?v=2" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead__row">
        <a href="/" class="brand" aria-label="iBIM home"><img src="/img/ibim-wordmark.png" alt="iBIM" width="191" height="88" /></a>
        <details class="menu" data-menu open>
          <summary>Menu</summary>
          <nav aria-label="Main">
            <details class="sub" data-sub open={servicesActive ? true : undefined}>
              <summary aria-current={servicesActive ? 'true' : undefined}>Services</summary>
              <div class="sub__panel">
                <p class="sub__label">Architectural</p>
                <ul>
                  {architecturalServices.map((s) => <li><a href={`/${s.slug}`} aria-current={`/${s.slug}` === path ? 'page' : undefined}>{s.name}</a></li>)}
                </ul>
                <p class="sub__label">BIM and digital</p>
                <ul>
                  {services.map((s) => <li><a href={`/${s.slug}`} aria-current={`/${s.slug}` === path ? 'page' : undefined}>{s.name}</a></li>)}
                </ul>
              </div>
            </details>
            <a href="/software-development" aria-current={path === '/software-development' ? 'page' : undefined}>Software and automation</a>
            <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
            <a class="button button--small" href="/contact">Contact us</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="wrap footer">
      <div class="titleblock" role="group" aria-label="Company details">
        <div class="tb tb--logo"><img src="/img/ibim-logo.png" alt="iBIM: simplifying AEC with integrated digital solutions" width="280" height="209" /></div>
        <div class="tb tb--tag">
          <span class="tb__label">Our aim</span>
          <p>Giving back to construction with advanced BIM solutions.</p>
        </div>
        <div class="tb">
          <span class="tb__label">Telephone</span>
          <a href={contact.phoneHref}>{contact.phone}</a>
        </div>
        <div class="tb">
          <span class="tb__label">Email</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </div>
        <div class="tb">
          <span class="tb__label">Hours</span>
          <span>{contact.hours}</span>
        </div>
        <div class="tb">
          <span class="tb__label">Follow</span>
          <a href={contact.linkedin} rel="noopener">LinkedIn</a>
        </div>
        <div class="tb">
          <span class="tb__label">Our values</span>
          <span>Trust, partner, innovate</span>
        </div>
        <div class="tb">
          <span class="tb__label">Areas we cover</span>
          <a href="/preston-lancashire">Preston and Lancashire</a>
        </div>
        <div class="tb">
          <span class="tb__label">Issued</span>
          <span>© {year} iBIM Limited. <a href="/privacy">Privacy</a></span>
        </div>
        <p class="tb tb--legal small">iBIM Limited. Registered in England and Wales, company number {contact.companyNumber}. Registered office: {contact.registeredOffice}.</p>
      </div>
    </footer>
  </body>
</html>
