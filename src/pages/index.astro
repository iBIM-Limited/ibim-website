---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { pillars, recentWork, contact, promise } from '../data/services';

const audiences = [
  {
    name: 'Homeowners',
    group: 'Design',
    need: 'Measured surveys, existing and proposed drawings, planning permission applications and building regulations drawings for extensions, conversions and new homes.',
    links: [
      { name: 'Architectural drawings', href: '/architectural-drawings' },
      { name: 'Planning submissions', href: '/planning-submissions' },
      { name: 'Building regulations', href: '/building-regulations-drawings' },
      { name: '3D visuals', href: '/3d-visuals-and-real-time-visualisation' },
    ],
  },
  {
    name: 'Developers',
    group: 'Design & Own',
    need: 'Coordinated architectural packages, laser scan site surveys and BIM information management across residential and commercial developments.',
    links: [
      { name: 'Planning submissions', href: '/planning-submissions' },
      { name: 'BIM advisory', href: '/bim-advisory' },
      { name: 'Reality capture', href: '/reality-capture-and-3d-modelling-services' },
      { name: '3D visuals', href: '/3d-visuals-and-real-time-visualisation' },
    ],
  },
  {
    name: 'Landowners',
    group: 'Own',
    need: 'Accurate boundary and topographic survey data, drone capture and planning submissions to unlock site value.',
    links: [
      { name: 'Reality capture', href: '/reality-capture-and-3d-modelling-services' },
      { name: 'Planning submissions', href: '/planning-submissions' },
      { name: 'Architectural drawings', href: '/architectural-drawings' },
    ],
  },
  {
    name: 'Construction companies',
    group: 'Build',
    need: 'Common data environment (CDE) management, clash detection, 4D construction sequencing and 5D cost integration on live projects.',
    links: [
      { name: 'Information management', href: '/information-management' },
      { name: '4D/5D sequencing', href: '/construction-sequencing-and-cost-consultancy-4d5d' },
      { name: 'Project management', href: '/project-management' },
    ],
  },
  {
    name: 'M&E companies',
    group: 'Build',
    need: 'MEP laser scanning, point cloud to Revit/IFC modelling and spatial coordination to resolve clashes before site installation.',
    links: [
      { name: 'Reality capture', href: '/reality-capture-and-3d-modelling-services' },
      { name: 'Information management', href: '/information-management' },
      { name: 'Digital twins', href: '/digital-twins-and-fm-consultancy' },
    ],
  },
];

const journeySteps = [
  {
    num: '01',
    name: 'Enquire',
    title: 'Four fields, then a call.',
    body: 'The site answers the first questions. The form takes a minute. The confirmation names who will reply and by when.',
  },
  {
    num: '02',
    name: 'Scope',
    title: 'One page, in writing.',
    body: 'Deliverables, formats, standards, price and dates on one page before any work starts. Anything we advise against is said here, with the cheaper route if there is one.',
  },
  {
    num: '03',
    name: 'Deliver',
    title: 'Shown before issued.',
    body: 'We walk you through the model or drawings on a call before formal issue. Progress is visible in your common data environment (CDE), or a shared folder if you have none.',
  },
  {
    num: '04',
    name: 'Hand over',
    title: 'Yours to run.',
    body: 'Native files, open formats, a short guide and the scripts we wrote. A check-in after the first month of use.',
  },
];
---
<Base
  title="BIM consultancy and architectural services | iBIM"
  description="BIM, architectural and planning services, backed by software and automation, for homeowners, developers, landowners, contractors and M&E firms."
>
  <!-- 1. Ink Hero on Drawing Grid (5.4) -->
  <section class="hero-ink drawing-grid">
    <div class="container hero-ink__grid">
      <div class="hero-ink__copy">
        <span class="eyebrow eyebrow--on-ink">Simplifying AEC</span>
        <h1>Drawings, BIM and software. <span class="hero-ink__highlight">One team.</span></h1>
        <p class="hero-ink__standfirst">
          We draw the building, manage its information and automate the admin in between.
        </p>
        <div class="hero-ink__actions">
          <a class="button button--large button--action" href="/contact">Start a project</a>
          <a class="button button--large button--secondary-ink" href="#how-we-work">See how we work</a>
        </div>
      </div>

      <figure class="model model--hero" data-model data-state="journey">
        <canvas role="img" aria-label="A building shown first as a laser scan point cloud, then a 3D model, then a realistic visualisation."></canvas>
        <figcaption class="mono small">Visualisation · illustrative, not a client project</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. The Three Pillars at Equal Width (5.4) -->
  <section class="section">
    <div class="container">
      <div style="margin-bottom: 32px;">
        <span class="eyebrow eyebrow--green">Our three pillars</span>
        <h2 style="margin-top: 8px;">Three disciplines. Equal weight.</h2>
      </div>

      <div class="pillars-grid">
        {pillars.map((p) => (
          <a href={p.href} class="service-card">
            <div class="service-card__icon">
              <Icon name={p.icon} size={28} />
            </div>
            <h3 class="service-card__title">{p.name}</h3>
            <span class="service-card__summary">{p.summary}</span>
            <p class="service-card__body">{p.body}</p>
            <span class="button button--tertiary">
              Explore {p.key === 'bim' ? 'BIM and digital' : p.name.toLowerCase()} <span class="arrow">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. The Organising Idea & Promise Band (1.2, 1.10) -->
  <section class="promise-band">
    <div class="container">
      <div class="promise-band__inner">
        <span class="eyebrow eyebrow--green">The organising idea</span>
        <h2>Simplifying AEC with <span class="green-word">integrated</span> digital solutions.</h2>
        <p>
          Architecture, engineering and construction (AEC) runs on information: drawings, models, programmes, costs and handover records. Too much of it sits in separate files, with separate teams, or in someone’s inbox. iBIM exists to join it up so you enter information once.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. How We Work / Client Journey (5.10) -->
  <section class="section" id="how-we-work">
    <div class="container">
      <div style="margin-bottom: 32px;">
        <span class="eyebrow eyebrow--green">The client journey</span>
        <h2 style="margin-top: 8px;">From enquiry to a model you can run.</h2>
      </div>

      <div class="process-grid">
        {journeySteps.map((s) => (
          <div class="process-card">
            <span class="process-card__step">STEP {s.num}</span>
            <h3 class="process-card__title">{s.title}</h3>
            <p class="process-card__body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Recent Work (5.7 - Text Cards, No Invented Results) -->
  <section class="section section--sm" style="background: var(--color-surface); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line);">
    <div class="container">
      <div style="margin-bottom: 32px;">
        <span class="eyebrow eyebrow--green">Recent work</span>
        <h2 style="margin-top: 8px;">Work completed.</h2>
      </div>

      <div class="work-grid">
        {recentWork.map((w) => (
          <a href={`/${w.slug}`} class="work-card">
            <span class="work-card__tag">{w.tag}</span>
            <h3 class="work-card__title">{w.title}</h3>
            <p class="work-card__body">{w.body}</p>
            <span class="button button--tertiary">
              View service <span class="arrow">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Who We Work With (1.8 - Homeowners, Developers, Landowners, Construction, M&E) -->
  <section class="section" id="who-we-work-with">
    <div class="container">
      <div style="margin-bottom: 32px;">
        <span class="eyebrow eyebrow--green">Who we work with</span>
        <h2 style="margin-top: 8px;">One supply chain. Built for every stage.</h2>
      </div>

      <div class="audiences-grid">
        {audiences.map((a) => (
          <div class="audience-card">
            <div>
              <span class="mono small" style="color: var(--color-signal-text); text-transform: uppercase;">{a.group}</span>
              <h3 style="margin-top: 4px;">{a.name}</h3>
            </div>
            <p>{a.need}</p>
            <div class="audience-card__links">
              {a.links.map((link) => (
                <a href={link.href}>{link.name}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Who Runs iBIM (4.2 Rewrite, 1.7 Personality) -->
  <section class="section section--sm">
    <div class="container">
      <div class="leadership-box">
        <div class="leadership-box__content">
          <span class="eyebrow eyebrow--green">Practice leadership</span>
          <h2>Who runs iBIM.</h2>
          <p class="standfirst" style="font-size: 18px;">
            A UK practice covering architectural drawings, BIM and software, run by a building surveyor with a postgraduate diploma in BIM and project management.
          </p>
          <p>
            iBIM Limited was incorporated in December 2024 and is based in Preston, Lancashire. We do the work ourselves: the person who scopes the job understands the drawing, the model and the code. At home on site in boots, precise in the model, and straight with you about what is worth automating.
          </p>
        </div>

        <div class="leadership-box__contact">
          <span class="mono small" style="text-transform: uppercase;">Direct contact</span>
          <strong style="font-size: 18px;">{contact.person}</strong>
          <span class="small">{contact.role} · BSc (Hons), PgDip</span>
          <a href={contact.phoneHref} class="mono" style="color: var(--color-signal-text); font-weight: 600; text-decoration: none;">
            {contact.phone}
          </a>
          <a href={`mailto:${contact.email}`} style="color: var(--color-ink); font-size: 14.5px;">
            {contact.email}
          </a>
          <a class="button button--small button--primary" href="/contact" style="margin-top: 8px;">
            Talk to Jack
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Contact Band / CTA -->
  <section class="cta-band">
    <div class="container">
      <h2>Bring us your next project.</h2>
      <p>Speak directly with Jack about drawings, BIM coordination or software tools.</p>
      <div class="cta-band__actions">
        <a class="button button--large button--action" href="/contact">Start a project</a>
        <a class="button button--large button--secondary-ink" href={contact.phoneHref}>Call {contact.phone}</a>
      </div>
    </div>
  </section>

  <script is:inline src="/js/model.js?v=14" defer></script>
</Base>
