---
import Base from '../layouts/Base.astro';
import { allServices, services } from '../data/services';

const initial = 'journey';
const byStage = Object.fromEntries(allServices.map((s) => [s.slug, s]));
const audiences = [
  { name: 'Homeowners', need: 'Drawings and approvals for your project.', links: ['architectural-drawings', 'planning-submissions', 'building-regulations-drawings', '3d-visuals-and-real-time-visualisation'] },
  { name: 'Developers', need: 'Drawings, approvals and coordination across a scheme.', links: ['planning-submissions', 'building-regulations-drawings', '3d-visuals-and-real-time-visualisation', 'bim-advisory'] },
  { name: 'Landowners', need: 'Site information and a route through planning.', links: ['planning-submissions', 'reality-capture-and-3d-modelling-services'] },
  { name: 'Construction companies', need: 'Coordination, sequencing and cost on site and in the office.', links: ['information-management', 'construction-sequencing-and-cost-consultancy-4d5d', 'reality-capture-and-3d-modelling-services'] },
  { name: 'M&E companies', need: 'MEP modelling and coordination with other disciplines.', links: ['reality-capture-and-3d-modelling-services', 'information-management'] },
];
const sectors = ['Residential', 'Commercial', 'Civil engineering and infrastructure', 'Industrial'];
---
<Base title="BIM consultancy and architectural services | iBIM" description="BIM, architectural and planning services, backed by software and automation, for homeowners, developers, landowners, contractors and M&amp;E firms.">
  <section class="wrap hero" id="lifecycle">
    <div class="hero__copy">
      <h1>We help you plan, design and deliver building projects</h1>
      <p class="lead">Architectural, planning, BIM and 3D visual services, backed by software and automation, for homeowners, developers, landowners, construction and M&amp;E companies.</p>
      <div class="actions">
        <a class="button" href="/contact">Talk to us about a project</a>
        <a class="textlink" href="/about">About iBIM</a>
      </div>
    </div>

    <figure class="model model--hero" data-model data-state="journey" data-lifecycle>
      <canvas role="img" aria-label="A building shown first as a laser scan point cloud, then a 3D model, then a realistic render."></canvas>
      <figcaption class="small">Illustrative, not a real project.</figcaption>
    </figure>

    <div class="lifecycle">
      <h2>End-to-end BIM lifecycle consulting</h2>
      <div class="stops" role="group" aria-label="Choose a lifecycle stage">
        {services.map((s) => (
          <button type="button" class="stop" data-stop={s.state} aria-pressed={s.state === initial ? 'true' : 'false'}>
            <span class="stop__stage">{s.stage}</span>
            <span class="stop__name">{s.short}</span>
          </button>
        ))}
      </div>
      <div class="stop-panels">
        {services.map((s) => (
          <div class="stop-panel" data-panel={s.state} hidden={s.state !== initial}>
            <p>{s.lead}</p>
            <a class="textlink" href={`/${s.slug}`}>{s.name}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap who" id="who">
    <h2>Who we work with</h2>
    <ul class="who__list">
      {audiences.map((a) => (
        <li>
          <h3>{a.name}</h3>
          <p>{a.need}</p>
          <ul class="who__links">
            {a.links.map((slug) => <li><a href={`/${slug}`}>{byStage[slug].short}</a></li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="approach">
    <div class="wrap approach__grid">
      <h2>A holistic view of the industry</h2>
      <div class="approach__body">
        <p>We take on the challenges people face day to day: eliminating silos, enabling smarter decisions and saving costs, with a green approach. As software and automation specialists, we look for better ways to work, not just more drawings.</p>
        <button type="button" class="video" data-video="ly6469N83WA" aria-label="Play the iBIM video about BIM. Loads from YouTube.">
          <img src="/img/video-bim.jpg" alt="" width="480" height="360" loading="lazy" />
          <span class="video__play">Play video (YouTube)</span>
        </button>
      </div>
    </div>
  </section>

  <section class="wrap sectors">
    <h2>Sectors we work in</h2>
    <ul>{sectors.map((s) => <li>{s}</li>)}</ul>
  </section>

  <section class="cta">
    <div class="wrap cta__grid">
      <div>
        <h2>Bring us your next project</h2>
        <p>Speak to us about planning, design, construction or operations.</p>
      </div>
      <a class="button button--ink" href="/contact">Contact iBIM</a>
    </div>
  </section>
  <script is:inline src="/js/model.js?v=12" defer></script>
</Base>
