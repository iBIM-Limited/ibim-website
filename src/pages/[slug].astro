---
import Base from '../layouts/Base.astro';
import { allServices, architecturalServices, services, contact } from '../data/services';

export function getStaticPaths() {
  return allServices.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const isArchitectural = service.group === 'architectural';
const peers = isArchitectural ? architecturalServices : services;
const i = peers.findIndex((s) => s.slug === service.slug);
const next = peers[(i + 1) % peers.length];
const prev = peers[(i - 1 + peers.length) % peers.length];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.serviceType ?? service.title,
  description: service.description,
  url: `https://www.i-bim.co.uk/${service.slug}`,
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Lancashire' }, { '@type': 'Country', name: 'United Kingdom' }],
  provider: { '@type': 'ProfessionalService', name: 'iBIM', url: 'https://www.i-bim.co.uk/', telephone: contact.phone },
};
---
<Base title={service.title} description={service.description} jsonLd={jsonLd}>
  <section class="wrap svc-hero">
    <div class="svc-hero__copy">
      <p class="crumb"><a href={isArchitectural ? '/#who' : '/#lifecycle'}>{isArchitectural ? 'Architectural services' : 'Project lifecycle'}</a> <span aria-hidden="true">/</span> {service.stage}</p>
      <h1>{service.title}</h1>
      <p class="lead">{service.lead}</p>
      <a class="button" href="/contact">Talk to us about this</a>
      <p class="small">We work across Lancashire and the wider UK. <a href="/preston-lancashire">Preston and Lancashire</a></p>
    </div>
    <figure class="model model--page" data-model data-state={service.state}>
      <canvas role="img" aria-label={`Illustration for ${service.stage.toLowerCase()}.`}></canvas>
      <figcaption class="small">{service.state === 'visual' || service.state === 'journey' ? 'Illustrative render, not a real project.' : isArchitectural ? 'Illustrative drawing, not a real project.' : 'Illustrative model. Drag to orbit.'}</figcaption>
    </figure>
  </section>

  <section class="wrap steps-section">
    <h2>How we work</h2>
    <ol class="steps">
      {service.steps.map((step) => (
        <li><h3>{step.title}</h3><p>{step.body}</p></li>
      ))}
    </ol>
    {service.includes && (
      <div class="includes">
        <h3>What this covers</h3>
        <ul>{service.includes.map((x) => <li>{x}</li>)}</ul>
      </div>
    )}
    {service.explainer && (
      <div class="split">
        <h2>{service.explainer.title}</h2>
        <div class="split__body">
          {service.explainer.body.map((x) => <p>{x}</p>)}
          {service.explainer.list && <ul>{service.explainer.list.map((x) => <li>{x}</li>)}</ul>}
        </div>
      </div>
    )}
    {service.questions && (
      <div class="split">
        <h2>Common questions</h2>
        <dl class="questions">
          {service.questions.map((x) => <div><dt>{x.q}</dt><dd>{x.a}</dd></div>)}
        </dl>
      </div>
    )}
  </section>

  <nav class="wrap pager" aria-label={isArchitectural ? 'Other architectural services' : 'Other lifecycle stages'}>
    <a href={`/${prev.slug}`}><span class="small">{isArchitectural ? 'Related service' : 'Previous stage'}</span>{prev.short}</a>
    <a href={`/${next.slug}`} class="pager__next"><span class="small">{isArchitectural ? 'Related service' : 'Next stage'}</span>{next.short}</a>
  </nav>
  <script is:inline src="/js/model.js?v=12" defer></script>
</Base>
