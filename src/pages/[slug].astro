---
import Base from '../layouts/Base.astro';
import { allServices, services, localServices } from '../data/services';

export function getStaticPaths() {
  return allServices.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const group = service.local ? localServices : services;
const i = group.findIndex((s) => s.slug === service.slug);
const next = group[(i + 1) % group.length];
const prev = group[(i - 1 + group.length) % group.length];
const jsonLd = service.local ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.serviceType,
  description: service.description,
  url: `https://www.i-bim.co.uk/${service.slug}`,
  areaServed: [{ '@type': 'City', name: 'Preston' }, { '@type': 'AdministrativeArea', name: 'Lancashire' }],
  provider: { '@type': 'ProfessionalService', name: 'iBIM', url: 'https://www.i-bim.co.uk/', telephone: '+44 7825 885167' },
} : undefined;
---
<Base title={service.title} description={service.description} jsonLd={jsonLd}>
  <section class="wrap svc-hero">
    <div class="svc-hero__copy">
      <p class="crumb"><a href={service.local ? '/#local' : '/#lifecycle'}>{service.local ? 'Preston and Lancashire' : 'Project lifecycle'}</a> <span aria-hidden="true">/</span> {service.stage}</p>
      <h1>{service.title}</h1>
      <p class="lead">{service.lead}</p>
      <a class="button" href="/contact">Talk to us about this</a>
    </div>
    <figure class="model model--page" data-model data-state={service.state}>
      <canvas role="img" aria-label={`Illustrated building model showing the ${service.stage.toLowerCase()} stage of a project.`}></canvas>
      <figcaption class="small">Illustrative model. Drag to orbit.</figcaption>
    </figure>
  </section>

  <section class="wrap steps-section">
    <h2>How we work</h2>
    <ol class="steps">
      {service.steps.map((step) => (
        <li><h3>{step.title}</h3><p>{step.body}</p></li>
      ))}
    </ol>
    {service.includes && (
      <div class="includes">
        <h3>What this covers</h3>
        <ul>{service.includes.map((x) => <li>{x}</li>)}</ul>
      </div>
    )}
    {service.explainer && (
      <div class="explainer">
        <h2>{service.explainer.title}</h2>
        <div class="explainer__body">
          {service.explainer.body.map((x) => <p>{x}</p>)}
          {service.explainer.list && <ul>{service.explainer.list.map((x) => <li>{x}</li>)}</ul>}
        </div>
      </div>
    )}
    {service.questions && (
      <div class="explainer">
        <h2>Common questions</h2>
        <dl class="questions">
          {service.questions.map((x) => <div><dt>{x.q}</dt><dd>{x.a}</dd></div>)}
        </dl>
      </div>
    )}
  </section>

  <nav class="wrap pager" aria-label="Other lifecycle stages">
    <a href={`/${prev.slug}`}><span class="small">Previous stage</span>{prev.short}</a>
    <a href={`/${next.slug}`} class="pager__next"><span class="small">Next stage</span>{next.short}</a>
  </nav>
  <script is:inline src="/js/model.js" defer></script>
</Base>
