---
import Base from '../layouts/Base.astro';
import { architecturalServices, services } from '../data/services';

const checklist = 'https://www.preston.gov.uk/article/5129/Validation-Checklist-for-Planning-and-Other-Applications';
---
<Base
  title="BIM and architectural services in Preston and Lancashire"
  description="BIM consultancy, architectural drawings, planning submissions and building regulations drawings for projects in Preston and across Lancashire."
>
  <div class="container section">
    <header style="max-width: 800px; margin-bottom: 64px;">
      <span class="eyebrow eyebrow--green">Lancashire coverage</span>
      <h1 style="margin-top: 8px; margin-bottom: 20px;">BIM and architectural services in Preston and Lancashire.</h1>
      <p class="standfirst">
        We work with homeowners, developers, landowners, construction and M&amp;E companies on projects in Preston and across Lancashire, as well as the wider UK, with software and automation behind how we work.
      </p>
      <div style="margin-top: 24px;">
        <a class="button button--action" href="/contact">Talk to us about your project</a>
      </div>
    </header>

    <div style="display: grid; gap: 72px;">
      <!-- Architectural Services Ledger -->
      <section class="editorial-split">
        <div class="editorial-split__head">
          <h2>Architectural and planning work.</h2>
          <p class="small">Measured surveys, planning applications and building regulations packages.</p>
        </div>

        <div class="ledger">
          {architecturalServices.map((s) => (
            <a href={`/${s.slug}`} class="ledger-row">
              <h3 class="ledger-row__title">{s.name}</h3>
              <p class="ledger-row__body">{s.card}</p>
              <span class="button button--tertiary">View service</span>
            </a>
          ))}
        </div>
      </section>

      <!-- BIM Services Ledger -->
      <section class="editorial-split">
        <div class="editorial-split__head">
          <h2>BIM and digital services.</h2>
          <p class="small">Reality capture, information management, 4D/5D and digital twins.</p>
        </div>

        <div class="ledger">
          {services.map((s) => (
            <a href={`/${s.slug}`} class="ledger-row">
              <h3 class="ledger-row__title">{s.name}</h3>
              <p class="ledger-row__body">{s.card}</p>
              <span class="button button--tertiary">View service</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Local Planning Applications & Recent Work -->
      <section class="editorial-split">
        <div class="editorial-split__head">
          <h2>Local planning and recent work.</h2>
        </div>

        <div class="ledger">
          <div class="ledger-row ledger-row--2col">
            <h3 class="ledger-row__title">Planning applications in Preston.</h3>
            <div style="display: flex; flex-direction: column; gap: 12px;" class="ledger-row__body">
              <p>
                Applications for sites within Preston go to Preston City Council. Its validation checklist, adopted in October 2024, sets out mandatory national requirements and local requirements based on the type of proposal.
              </p>
              <p>
                <a href={checklist} rel="noopener noreferrer" target="_blank" style="color: var(--color-signal-text); font-weight: 600;">
                  Read Preston City Council’s validation checklist
                </a>
              </p>
              <p>
                Elsewhere in Lancashire (Fylde, Wyre, Ribble Valley, South Ribble, Lancaster), each local planning authority publishes its own validation requirements. We check what your council requires before submitting.
              </p>
            </div>
          </div>

          <div class="ledger-row ledger-row--2col">
            <h3 class="ledger-row__title">Recent local work.</h3>
            <div style="display: flex; flex-direction: column; gap: 12px;" class="ledger-row__body">
              <p>
                <strong style="color: var(--color-ink);">Planning drawings for a house in Lytham:</strong> Architectural drawings prepared and submitted for a residential planning application.
              </p>
              <div>
                <a class="button button--tertiary" href="/planning-submissions">
                  See planning submissions service
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQs -->
      <section class="editorial-split">
        <div class="editorial-split__head">
          <h2>Common questions.</h2>
        </div>

        <dl class="faq-list" style="border-top: 1px solid var(--color-line); padding-top: 24px;">
          <div class="faq-item">
            <dt>Do you only work in Preston?</dt>
            <dd>No. We work across Lancashire and the wider UK. This page is for anyone looking for technical drawing or BIM support locally.</dd>
          </div>
          <div class="faq-item">
            <dt>Which council handles my planning application?</dt>
            <dd>Usually the local district or borough council for the area where the site is situated. If you are not sure, tell us the address and we will confirm the planning authority for you.</dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</Base>
