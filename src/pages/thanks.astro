---
import Base from '../layouts/Base.astro';
---
<Base title="Message sent" description="Your message has been sent to iBIM." noindex>
  <div class="container section" style="min-height: 60vh; display: flex; flex-direction: column; justify-content: center;">
    <header style="max-width: 600px;">
      <span class="mono eyebrow eyebrow--green">Confirmation</span>
      <h1 style="margin-top: 8px; margin-bottom: 16px;">Message sent.</h1>
      <p class="standfirst" style="font-size: 18px; margin-bottom: 28px;">
        Jack replies personally, usually within one working day.
      </p>
      <div>
        <a class="button button--primary" href="/">Go to home</a>
      </div>
    </header>
  </div>
</Base>
