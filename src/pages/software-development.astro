---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
---
<Base title="Software development" description="iBIM is investing in a digital twin platform that connects BIM workflows to facilities management using AI. Join the waiting list.">
  <section class="wrap contact">
    <div class="contact__intro">
      <h1>A digital twin platform for BIM and FM</h1>
      <p class="lead">We’re investing in a digital twin platform that connects BIM workflows to facilities management using AI.</p>
      <p>Join the waiting list to hear about it first.</p>
    </div>
    <div class="contact__form">
      <h2>Join the waiting list</h2>
      <Form kind="waitlist" />
    </div>
  </section>
</Base>
