---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title="Software and automation"
  description="iBIM uses software and automation in its BIM and architectural work, builds custom dashboards and reporting, and is investing in a digital twin platform."
>
  <div class="container section">
    <div style="display: grid; grid-template-columns: 1fr; gap: 64px;">
      <header style="max-width: 800px;">
        <span class="eyebrow eyebrow--green">Software and automation</span>
        <h1 style="margin-top: 8px; margin-bottom: 20px;">Software and automation.</h1>
        <p class="standfirst">
          We’re software and automation specialists working across BIM and architectural projects, so routine work takes less time and your project information is easier to use.
        </p>
      </header>

      <!-- What we build — Architectural Sheet Columns -->
      <section>
        <h2 style="margin-bottom: 24px;">Tools that remove repeated admin.</h2>

        <div class="pillars-sheet">
          <div class="pillar-col">
            <div class="pillar-col__icon">
              <Icon name="scan-line" size={24} />
            </div>
            <h3 class="pillar-col__title">3D modelling automation.</h3>
            <p class="pillar-col__body" style="margin-bottom: 0;">
              Automating repeated steps in reality capture, turning laser scan point clouds and survey data into clean, reliable models faster.
            </p>
          </div>

          <div class="pillar-col">
            <div class="pillar-col__icon">
              <Icon name="folder-tree" size={24} />
            </div>
            <h3 class="pillar-col__title">Dashboards and reporting.</h3>
            <p class="pillar-col__body" style="margin-bottom: 0;">
              Custom scripts and dashboards that audit models, track clashes by owner and date, and extract schedules directly into spreadsheet formats.
            </p>
          </div>

          <div class="pillar-col">
            <div class="pillar-col__icon">
              <Icon name="building-2" size={24} />
            </div>
            <h3 class="pillar-col__title">Digital twin platform.</h3>
            <p class="pillar-col__body" style="margin-bottom: 0;">
              A platform we are investing in that links BIM handover files and open IFC models to live facilities management data and maintenance history.
            </p>
          </div>
        </div>
      </section>

      <!-- Talk to us & Waiting list — Editorial Split -->
      <div style="display: grid; grid-template-columns: 1fr; gap: 48px;" class="software-grid">
        <div>
          <h2 style="margin-bottom: 16px;">Have a process that takes too long?</h2>
          <p style="font-size: 16px; line-height: 1.55; color: var(--color-ink-60); margin-bottom: 24px;">
            If your team spends hours each week reformatting drawing schedules, renaming files or manually checking clash reports, we can write a script or build a tool to handle it.
          </p>
          <a class="button button--primary" href="/contact">
            Talk to us about automation
          </a>
        </div>

        <div style="border-top: 3px solid var(--color-ink); background: var(--color-surface); padding: clamp(28px, 4vw, 40px);">
          <span class="eyebrow eyebrow--green">Digital twin platform</span>
          <h2 style="font-size: 22px; margin-top: 6px; margin-bottom: 12px;">Join the platform waiting list.</h2>
          <p class="small" style="margin-bottom: 24px;">
            Be the first to hear about our digital twin platform as it develops. We will email you only when there is news.
          </p>
          <Form kind="waitlist" />
        </div>
      </div>
    </div>
  </div>

  <style>
    @media (min-width: 900px) {
      .software-grid {
        grid-template-columns: 1fr 1.2fr !important;
        gap: 72px !important;
        align-items: start;
      }
    }
  </style>
</Base>
