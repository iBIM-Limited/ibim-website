---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { contact } from '../data/services';
---
<Base title="Contact iBIM" description="Contact iBIM for BIM solutions tailored to your planning, design, construction and operations needs." sheetName="Contact">
  <section class="wrap contact">
    <div class="contact__intro">
      <h1>Contact us</h1>
      <p class="lead">Speak to us about BIM, architectural drawings, planning submissions or building regulations, in Preston, across Lancashire or further afield.</p>
      <dl class="details">
        <div><dt>Telephone or WhatsApp</dt><dd><a href={contact.phoneHref}>{contact.phone}</a></dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
        <div><dt>Hours</dt><dd>{contact.hours}</dd></div>
      </dl>
    </div>
    <div class="contact__form">
      <h2>Send us a message</h2>
      <Form kind="contact" />
    </div>
  </section>
</Base>
