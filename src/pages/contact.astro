---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { contact } from '../data/services';
---
<Base
  title="Contact iBIM"
  description="Contact iBIM for BIM solutions tailored to your planning, design, construction and operations needs."
>
  <div class="container section">
    <div style="display: grid; grid-template-columns: 1fr; gap: 56px;">
      <header class="page-head" style="max-width: 680px;">
        <span class="eyebrow eyebrow--green">Contact us</span>
        <h1 style="margin-top: 8px; margin-bottom: 16px;">Tell us about the job.</h1>
        <p class="standfirst">About one minute. We reply within one working day.</p>
      </header>

      <div style="display: grid; grid-template-columns: 1fr; gap: 56px;" class="contact-grid">
        <!-- Form Column -->
        <div>
          <Form kind="contact" />
        </div>

        <!-- Direct Contact Info Column — Structured like a Drawing Titleblock -->
        <aside class="service-panel" style="position: static; height: fit-content;">
          <div>
            <span class="service-panel__title">Direct contact</span>
            <strong style="display: block; font-size: 20px; margin-top: 6px; margin-bottom: 4px;">{contact.person}</strong>
            <p class="small">{contact.role}</p>
          </div>

          <dl class="typical-list">
            <div>
              <dt>Telephone / WhatsApp</dt>
              <dd>
                <a href={contact.phoneHref} class="mono" style="font-weight: 600; color: var(--color-signal-text); text-decoration: none;">
                  {contact.phone}
                </a>
              </dd>
            </div>

            <div>
              <dt>Email</dt>
              <dd>
                <a href={`mailto:${contact.email}`} style="color: var(--color-ink); text-decoration: none;">
                  {contact.email}
                </a>
              </dd>
            </div>

            <div>
              <dt>Working hours</dt>
              <dd>{contact.hours}</dd>
            </div>
          </dl>

          <div style="padding-top: 16px; border-top: 1px solid var(--color-line);">
            <p class="small">
              Based in Wesham, Preston, working on building projects across Lancashire and the wider UK.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <style>
    @media (min-width: 900px) {
      .contact-grid {
        grid-template-columns: 1.3fr 0.8fr !important;
        gap: 72px !important;
      }
    }
  </style>
</Base>
